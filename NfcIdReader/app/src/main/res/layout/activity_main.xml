<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="أدخل البيانات من منطقة MRZ (ظهر البطاقة):"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etDocNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="رقم البطاقة (رقم الوثيقة)"
            android:inputType="textCapCharacters" />

        <EditText
            android:id="@+id/etBirth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="تاريخ الميلاد YYMMDD (مثال 950314)"
            android:inputType="number"
            android:maxLength="6" />

        <EditText
            android:id="@+id/etExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="تاريخ الانتهاء YYMMDD (مثال 310520)"
            android:inputType="number"
            android:maxLength="6" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="ضع البطاقة على ظهر الهاتف..."
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivPhoto"
            android:layout_width="160dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textIsSelectable="true"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
